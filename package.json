{
  "name": "joevix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restyle and rearrange pages on your own screen. Local only.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
