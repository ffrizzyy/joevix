{
  "name": "joevix",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Restyle and rearrange pages on your own screen. Local only.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "build:e2e": "wxt build && node scripts/make-e2e-extension.mjs",
    "check:size": "node scripts/check-size.mjs .output/chrome-mv3 .output/firefox-mv3",
    "check:manifest": "node scripts/check-manifest.mjs",
    "package:release": "node scripts/package-release.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
